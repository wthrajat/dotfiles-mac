#                             label="Title"                           \
#                             background.padding_left=0               \
#                             icon.padding_left=0                     \
#                             icon.padding_right=0                    \
#                             script='./scripts/title.sh'             \
#                             background.border_color=$PILL_BORDER    \
#                             label.max_chars=54                      # \
#                             # scroll_texts=on                         \
#                             # label.scroll_duration=200

# sketchybar --subscribe title title_change


# ~~ right items ~~

# battery
sketchybar --add item battery right                                 \
           --set      battery icon=                              \
                               icon.color=$SKY                     \
                              label="--%"                           \
                              script='./scripts/battery.sh'         \
                              update_freq=60


# time
sketchybar --add item time right                                    \
           --set      time icon=􀐬                                   \
                           icon.color=$SKY                     \
                           label="$(date '+%I:%M %p')"              \
                           script='./scripts/time.sh'               \
                           update_freq=60

# date
sketchybar --add item date right                                    \
           --set      date icon=􀧞                                   \
                           icon.color=$SKY                         \
                           label="$(date '+%a %b %d')"              \
                            script='./scripts/date.sh'               \
                            update_freq=60


# cpu
sketchybar --add item cpu right                                    \
           --set      cpu icon.color=$SKY                         \
                           script='./scripts/cpu.sh'               \
                           update_freq=10


# memory
sketchybar --add item memory right                                    \
           --set      memory icon.color=$SKY                       \
                           script='./scripts/memory.sh'           \
                           update_freq=5



# cpu temp (mean across CPU die banks via mac-temp, no sudo)
sketchybar --add item temp right                                   \
           --set      temp icon=󰔏                                  \
                            icon.color=$SKY                      \
                           script='./scripts/temps.sh'            \
                           update_freq=10


